{
  "expo": {
    "name": "MedNova",
    "slug": "mednova",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mednova",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1738",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.Novagames.MedNova",
      "supportsTablet": false,
      "requireFullScreen": true,
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.novagames.mednova",
      "adaptiveIcon": {
        "backgroundColor": "#070a1c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "googleServicesFile": "./firebase/google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 8,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "MedNova saves the wallpapers you choose to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "./plugins/withAndroidGameAndSaveOnly",
      "./plugins/withPhoneArchsOnly",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.novagames.mednova.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.revenuecat.purchases.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.google.firebase.** { *; }\n-keep class io.invertase.** { *; }\n-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod"
          },
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3390074715930067~8470693909",
          "iosAppId": "ca-app-pub-3390074715930067~4507398167",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "MedNova uses this to show you more relevant ads. The games stay free either way."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/analytics",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6fd6ff"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "41a99931-ac9e-4ed3-bcf7-0e541ef2ed0e"
      }
    },
    "owner": "mednova"
  }
}
